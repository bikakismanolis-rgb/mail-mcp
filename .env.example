# Random secret, at least 24 characters. Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# One line per mailbox: address, space, app password (never your normal password).
MAIL_ACCOUNT_1=you@gmail.com abcd efgh ijkl mnop
# MAIL_ACCOUNT_2=you@yahoo.com apppassword

# Azure app id, needed only for Hotmail / Outlook.com (see README).
# OUTLOOK_CLIENT_ID=

# Leave unset to allow drafts only. Set to true to expose the send_email tool.
# MAIL_ALLOW_SEND=true
